# Copy to .env and fill in. .env is gitignored. Never paste these values in chat, issues or logs.
EARTHDATA_TOKEN=
CDSAPI_KEY=
USDA_QUICKSTATS_KEY=

# Voice and chat providers (each is optional; the app falls back to a scripted conversation without them)
GEMINI_API_KEY=
GROQ_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional second key, used when the first one runs out of free quota
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Hamsa Arabic voice (text to speech, speech to text)
HAMSA_API_KEY=
HAMSA_API_KEY_2=
HAMSA_API_KEY_3=
